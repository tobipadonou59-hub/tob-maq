# Copiez ce fichier en .env (en local) ou recopiez chaque ligne dans les « Environment Variables »
# de votre hébergeur. Ne publiez JAMAIS le fichier .env : il contient vos clés.

# --- Claude (console.anthropic.com > API Keys) ---
ANTHROPIC_API_KEY=
# Modèle utilisé. claude-haiku-5-5 coûte environ 30 fois moins cher si vous voulez réduire la facture.
CLAUDE_MODEL=claude-opus-5-5
# Profondeur de réflexion : low, medium ou high (plus haut = plus soigné mais plus cher).
CLAUDE_EFFORT=medium

# --- WhatsApp Business Platform (developers.facebook.com > votre app > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Paramètres de l'app > Général > Clé secrète : sert à vérifier que les messages viennent bien de Meta.
WHATSAPP_APP_SECRET=
# Mot de passe de votre choix, à recopier dans Meta lors de la configuration du webhook.
WHATSAPP_VERIFY_TOKEN=

# --- Vos accès ---
# Mot de passe du tableau de bord (au moins 24 caractères, inventez-le).
ADMIN_TOKEN=
# Jeton (différent) pour le raccourci iPhone qui demande seulement des suggestions.
RACCOURCI_TOKEN=

# --- Options ---
# Fuseau horaire pour « bonjour / bonsoir » et l'affichage.
TZ=Africa/Porto-Novo
# Attente (ms) après le dernier message d'un contact avant de répondre : regroupe les messages envoyés à la suite.
DELAI_REGROUPEMENT_MS=20000
# Nombre de jours de conservation des messages sur le serveur.
RETENTION_JOURS=30
# Notification sur l'iPhone (application gratuite « ntfy ») : nom de sujet long et secret, ou vide.
NTFY_TOPIC=
# Dossier de la base de données (sur Render : /data, le disque permanent).
STORAGE_DIR=
TRUST_PROXY=1
