# Copiez ce fichier en « .env » (jamais publié) ou définissez ces variables chez votre hébergeur.

# Adresse publique du site (sert aux liens envoyés par e-mail et à la protection CSRF)
PUBLIC_URL=https://tob-maq.exemple.bj
PORT=8080
# 1 si le serveur est derrière un proxy HTTPS (Railway, Render, Fly.io, Nginx…)
TRUST_PROXY=1
# Dossier de la base SQLite et des fichiers envoyés (volume persistant en production)
STORAGE_DIR=storage

# Adresses e-mail qui deviennent administrateurs à l'inscription (séparées par des virgules)
ADMIN_EMAILS=

# E-mails (accord parental, mot de passe oublié). Sans clé, les e-mails s'affichent dans le journal.
BREVO_API_KEY=
MAIL_FROM=no-reply@tob-maq.exemple.bj
CONTACT_EMAIL=

# IA : génération d'images via OpenAI. Sans clé, le studio indique « service non configuré ».
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Coût estimé d'une image en FCFA, utilisé pour le plafond de budget mensuel
AI_IMAGE_COST_FCFA=40

MAX_UPLOAD_MB=50
SESSION_DAYS=30

# Abonnement Premium (FedaPay : MTN MoMo, Moov Money, cartes).
# Clé SECRÈTE de ton compte FedaPay (sk_sandbox_… pour les essais, sk_live_… pour encaisser).
FEDAPAY_SECRET_KEY=
# sandbox (essais, aucun argent réel) ou live (encaissement réel)
FEDAPAY_ENV=sandbox
