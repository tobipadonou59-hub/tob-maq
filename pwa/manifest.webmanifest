{
  "id": "/",
  "name": "TOB-MAQ · Académie numérique",
  "short_name": "TOB-MAQ",
  "description": "Formations, jeux et ressources pour les métiers créatifs et du numérique au Bénin : graphisme, vidéo, web, informatique, marketing.",
